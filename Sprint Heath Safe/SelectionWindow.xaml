<Window x:Class="Sprint_Heath.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SprintHealth"
        Width="920"
        Height="620"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <ImageBrush ImageSource="Images\HK background startpage.png" Stretch="UniformToFill" />
            </Rectangle.Fill>
        </Rectangle>

        <Border Margin="56"
                Padding="32"
                Background="#F7FAFC"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Выберите спринт"
                               FontFamily="Fonts\#Notable"
                               FontSize="28"
                               Foreground="#155E75"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,14,0,0"
                               FontFamily="Fonts\#Oswald"
                               FontSize="18"
                               Foreground="#486581"
                               HorizontalAlignment="Center"
                               Text="Каждая кнопка открывает отдельный анализ по выбранному спринту." />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,28,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SprintButtonsPanel" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
