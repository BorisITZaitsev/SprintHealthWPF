<Window x:Class="Sprint_Heath.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="SprintHealth"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <ImageBrush ImageSource="Images\HK background startpage.png" Stretch="UniformToFill" />
            </Rectangle.Fill>
        </Rectangle>

        <Border Margin="44"
                Padding="30"
                Background="#F7FAFC"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="320" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SprintTitle"
                           Grid.Row="0"
                           Margin="0,0,0,20"
                           FontFamily="Fonts\#Notable"
                           FontSize="22"
                           Foreground="#155E75"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Border Grid.Row="1"
                        Padding="16"
                        Background="White"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1"
                        CornerRadius="20">
                    <ScottPlot:WpfPlot x:Name="SprintPlot" />
                </Border>

                <ScrollViewer Grid.Row="2"
                              Margin="0,22,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="OutputTextBlock1"
                                   Margin="0,0,0,12"
                                   FontFamily="Fonts\#Oswald"
                                   FontSize="20"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="OutputTextBlock2"
                                   Margin="0,0,0,12"
                                   FontFamily="Fonts\#Oswald"
                                   FontSize="20"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="OutputTextBlock3"
                                   Margin="0,0,0,12"
                                   FontFamily="Fonts\#Oswald"
                                   FontSize="20"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="OutputTextBlock4"
                                   FontFamily="Fonts\#Oswald"
                                   FontSize="20"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3"
                            Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Margin="0,0,12,0"
                            Padding="18,10"
                            Background="White"
                            BorderBrush="#2F855A"
                            Foreground="#2F855A"
                            FontFamily="Fonts\#Oswald"
                            FontSize="18"
                            Content="Показать расчеты"
                            Click="CallMessageBox" />
                    <Button Padding="18,10"
                            Background="White"
                            BorderBrush="#2B6CB0"
                            Foreground="#2B6CB0"
                            FontFamily="Fonts\#Oswald"
                            FontSize="18"
                            Content="Назад"
                            Click="PreviousWindow" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
